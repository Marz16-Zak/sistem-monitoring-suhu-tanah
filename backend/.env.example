# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True

# Database Configuration
DATABASE_URL=mysql+pymysql://root:password@localhost/monitoring_suhu_tanah

# Sensor Configuration
SENSOR_UPDATE_INTERVAL=30
DATA_RETENTION_DAYS=7

# Thresholds
SOIL_MOISTURE_MIN=30
SOIL_MOISTURE_MAX=80
TEMP_MIN=15
TEMP_MAX=35
HUMIDITY_MAX=95
PUMP_ACTIVATION_THRESHOLD=30

# WiFi Configuration (for ESP32)
WIFI_SSID=your-wifi-ssid
WIFI_PASSWORD=your-wifi-password
BACKEND_URL=http://your-backend-ip:5000
